{% comment %}
  Urban Reader - Elite Side-by-Side Contact UI
  Centered Form with Vertical Sidebar Cards | Modern UI
{% endcomment %}

<style>
  :root {
    --brand-blue: {{ section.settings.brand_blue }};
    --brand-red: {{ section.settings.brand_hover }};
    --text-dark: #0f172a;
    --text-muted: #64748b;
    --white: #ffffff;
    --bg-light: {{ section.settings.bg_color }};
  }

  .ur-contact-v5 {
    padding: {{ section.settings.padding_top }}px 0 0;
    background: var(--bg-light);
    font-family: 'Inter', sans-serif;
  }

  .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }

  /* Header Section */
  .contact-header { text-align: center; margin-bottom: 60px; }
  .contact-header h1 { 
    font-size: {{ section.settings.h1_size }}px; 
    color: var(--text-dark); 
    font-weight: 900; 
    letter-spacing: -1.5px;
    margin-bottom: 15px;
  }
  .contact-header p { font-size: 18px; color: var(--text-muted); max-width: 600px; margin: 0 auto; }

  /* Main Flex Layout */
  .contact-flex-wrapper {
    display: flex;
    gap: 40px;
    margin-bottom: 80px;
    align-items: flex-start;
  }

  /* Form Styling (Left Side) */
  .form-side {
    flex: 1.5;
    background: var(--white);
    padding: 50px;
    border-radius: 35px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.05);
    border: 1px solid #f1f5f9;
  }

  .form-side h2 { font-size: 28px; font-weight: 800; color: var(--text-dark); margin-bottom: 30px; }
  .ur-input-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }

  .ur-field { width: 100%; padding: 16px 20px; border: 2px solid #f8fafc; border-radius: 14px; background: #f8fafc; font-size: 16px; transition: 0.3s; outline: none; }
  .ur-field:focus { border-color: var(--brand-blue); background: var(--white); box-shadow: 0 0 0 4px rgba(18, 155, 215, 0.1); }

  .ur-submit-btn {
    width: 100%; padding: 18px; background: var(--brand-blue); color: white; border: none; border-radius: 14px;
    font-size: 17px; font-weight: 800; cursor: pointer; transition: 0.4s; text-transform: uppercase; letter-spacing: 1px;
  }
  .ur-submit-btn:hover { background: var(--brand-red); transform: translateY(-3px); box-shadow: 0 10px 20px rgba(218, 63, 63, 0.2); }

  /* Info Sidebar (Right Side Vertical) */
  .info-sidebar { flex: 0.8; display: flex; flex-direction: column; gap: 20px; }

  .vertical-info-card {
    background: var(--white);
    padding: 25px;
    border-radius: 24px;
    display: flex;
    align-items: center;
    gap: 20px;
    border: 1px solid #f1f5f9;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    text-decoration: none;
  }

  .vertical-info-card:hover {
    transform: scale(1.05);
    border-color: var(--brand-blue);
    box-shadow: 0 15px 30px rgba(18, 155, 215, 0.1);
  }

  .sidebar-icon {
    width: 55px; height: 55px;
    background: #f0f9ff;
    border-radius: 16px;
    display: flex;
    align-items: center; justify-content: center;
    flex-shrink: 0;
    transition: 0.3s;
  }

  .vertical-info-card:hover .sidebar-icon { background: var(--brand-blue); }
  .sidebar-icon img { width: 24px; height: 24px; transition: 0.3s; }
  .vertical-info-card:hover .sidebar-icon img { filter: brightness(0) invert(1); }

  .sidebar-text h4 { font-size: 14px; color: var(--brand-blue); text-transform: uppercase; font-weight: 800; margin-bottom: 4px; }
  .sidebar-text p { font-size: 15px; color: var(--text-dark); font-weight: 600; margin: 0; line-height: 1.4; }

  /* Full Map */
  .full-map { width: 100%; height: 450px; line-height: 0; margin-top: 20px; }
  .full-map iframe { width: 100%; height: 100%; border: 0; filter: grayscale(0.1); }

  /* Responsive */
  @media (max-width: 991px) {
    .contact-flex-wrapper { flex-direction: column; }
    .form-side, .info-sidebar { width: 100%; flex: none; }
    .info-sidebar { flex-direction: row; flex-wrap: wrap; }
    .vertical-info-card { flex: 1; min-width: 250px; }
  }

  @media (max-width: 767px) {
    .ur-input-row { grid-template-columns: 1fr; gap: 0; }
    .form-side { padding: 30px 20px; }
    .info-sidebar { flex-direction: column; }
    .vertical-info-card { width: 100%; }
  }
</style>

<div class="ur-contact-v5">
  <div class="container">
    <div class="contact-header">
      <h1 style="font-size: {{ section.settings.h1_size }}px;">{{ section.settings.h1_text }}</h1>
      <p>{{ section.settings.sub_text }}</p>
    </div>

    <div class="contact-flex-wrapper">
      <div class="form-side">
        <h2>{{ section.settings.form_title }}</h2>
        {%- form 'contact', id: 'ContactFormV5' -%}
          {%- if form.posted_successfully? -%}
            <p style="background: #dcfce7; color: #166534; padding: 15px; border-radius: 10px; font-weight: bold; text-align: center;">✓ Your message reached us safely!</p>
          {%- endif -%}

          <div class="ur-input-row">
            <div style="margin-bottom: 20px;"><input type="text" name="contact[name]" class="ur-field" placeholder="Full Name" required></div>
            <div style="margin-bottom: 20px;"><input type="email" name="contact[email]" class="ur-field" placeholder="Email Address" required></div>
          </div>
          <div style="margin-bottom: 20px;"><input type="tel" name="contact[phone]" class="ur-field" placeholder="Phone Number (Optional)"></div>
          <div style="margin-bottom: 25px;"><textarea name="contact[body]" class="ur-field" style="min-height: 140px;" placeholder="How can we help you today?"></textarea></div>
          <button type="submit" class="ur-submit-btn">Send Message</button>
        {%- endform -%}
      </div>

      <div class="info-sidebar">
        <a href="tel:{{ section.settings.phone }}" class="vertical-info-card">
          <div class="sidebar-icon">
            {% if section.settings.icon_phone %}<img src="{{ section.settings.icon_phone | img_url: '60x' }}">{% else %}<img src="https://cdn-icons-png.flaticon.com/512/3059/3059590.png">{% endif %}
          </div>
          <div class="sidebar-text">
            <h4>Call Us</h4>
            <p>{{ section.settings.phone }}</p>
          </div>
        </a>

        <a href="mailto:{{ section.settings.email }}" class="vertical-info-card">
          <div class="sidebar-icon">
            {% if section.settings.icon_email %}<img src="{{ section.settings.icon_email | img_url: '60x' }}">{% else %}<img src="https://cdn-icons-png.flaticon.com/512/2099/2099199.png">{% endif %}
          </div>
          <div class="sidebar-text">
            <h4>Email Us</h4>
            <p>{{ section.settings.email }}</p>
          </div>
        </a>

        <div class="vertical-info-card">
          <div class="sidebar-icon">
            {% if section.settings.icon_address %}<img src="{{ section.settings.icon_address | img_url: '60x' }}">{% else %}<img src="https://cdn-icons-png.flaticon.com/512/1865/1865269.png">{% endif %}
          </div>
          <div class="sidebar-text">
            <h4>Visit Us</h4>
            <p>{{ section.settings.address }}</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="full-map">
    {{ section.settings.map_iframe }}
  </div>
</div>

{% schema %}
{
  "name": "Elite Side Contact",
  "settings": [
    { "type": "color", "id": "brand_blue", "label": "Brand Blue", "default": "#129BD7" },
    { "type": "color", "id": "brand_hover", "label": "Hover Red", "default": "#DA3F3F" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#fcfdfe" },
    { "type": "range", "id": "h1_size", "min": 30, "max": 70, "step": 1, "unit": "px", "label": "Title Size", "default": 55 },
    { "type": "text", "id": "h1_text", "label": "Main Title", "default": "Let's Connect" },
    { "type": "text", "id": "sub_text", "label": "Subtitle", "default": "Building a community one story at a time. Reach out to us today." },
    { "type": "text", "id": "form_title", "label": "Form Title", "default": "Drop Us a Line" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "980-505-7164" },
    { "type": "text", "id": "email", "label": "Email", "default": "info@urbanreaderbook.com" },
    { "type": "textarea", "id": "address", "label": "Address", "default": "P.O Box 7996, Concord, NC 28027" },
    { "type": "image_picker", "id": "icon_phone", "label": "Phone Icon" },
    { "type": "image_picker", "id": "icon_email", "label": "Email Icon" },
    { "type": "image_picker", "id": "icon_address", "label": "Address Icon" },
    { "type": "textarea", "id": "map_iframe", "label": "Google Map Code" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 5, "unit": "px", "label": "Top Space", "default": 80 }
  ],
  "presets": [ { "name": "Elite Side Contact" } ]
}
{% endschema %}